# Standard PostgreSQL Connection String:
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?schema=public
#
# Examples:
# - Local PostgreSQL:
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vani_milk_center?schema=public"
#
# - Cloud PostgreSQL (Neon, Render, Aiven, Railway, etc.):
#   DATABASE_URL="postgresql://username:password@your-postgres-host.com:5432/vani_milk_center?sslmode=require"
#
# - Supabase PostgreSQL (Transaction Pooler - Port 6543):
#   DATABASE_URL="postgresql://postgres.[project-ref]:[YOUR_PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres"
#
# - Supabase PostgreSQL (Direct - Port 5432):
#   DIRECT_URL="postgresql://postgres:[YOUR_PASSWORD]@db.[project-ref].supabase.co:5432/postgres"
#
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vani_milk_center?schema=public"

# Admin Authentication Secret for JWT session tokens
JWT_SECRET="dairy_secret_super_secure_key_2026_jwt_token"

# Default Admin Credentials for initial seeding & login
ADMIN_EMAIL="siddreddylakshmankumar@gmail.com"
ADMIN_PASSWORD="VANI@MILK"

# Shop Owner Alerts & Contact Configuration
OWNER_ALERT_EMAIL="siddreddylakshmankumar@gmail.com"
SECONDARY_OWNER_ALERT_EMAIL="siddireddytejapavan@gmail.com"
SHOP_WHATSAPP_NUMBER="917995597719"

# Optional SMTP Configuration for sending actual inbox alert emails
